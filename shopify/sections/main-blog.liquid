<section class="container-r section">
  <h1 style="font-size:2.5rem;">{{ blog.title }}</h1>
  <div style="margin-top:2rem;display:grid;gap:2rem;">
    {% for article in blog.articles %}
      <a href="{{ article.url }}"><h3 style="font-size:1.25rem;">{{ article.title }}</h3><p class="text-muted">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p></a>
    {% endfor %}
  </div>
</section>
{% schema %}{ "name": "Blog", "settings": [] }{% endschema %}
