<div class="drawer-overlay" id="cart-drawer" data-section-id="{{ section.id }}">
  <div class="drawer-overlay__bg"></div>
  <aside class="drawer-panel drawer-panel--end" style="max-width:28rem;display:flex;flex-direction:column;padding:0;">
    <div class="drawer-panel__head" style="padding:1.25rem 1.5rem;border-bottom:1px solid var(--color-border);">
      <h3 style="font-size:1.25rem;">{{ 'general.cart.your_cart' | t }} ({{ cart.item_count }})</h3>
      <button data-close-drawer="cart-drawer" aria-label="Close">{% render 'icon-x' %}</button>
    </div>
    <div style="padding:1rem 1.5rem;border-bottom:1px solid var(--color-border);">{% render 'cart-rewards' %}</div>

    {% if cart.item_count == 0 %}
      <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1rem;padding:1.5rem;text-align:center;">
        <p class="text-muted">{{ 'general.cart.empty' | t }}</p>
        <button data-close-drawer="cart-drawer" style="text-decoration:underline;font-size:.875rem;">{{ 'general.cart.continue_shopping' | t }}</button>
      </div>
    {% else %}
      <div style="flex:1;overflow-y:auto;padding:1rem 1.5rem;">
        {% for item in cart.items %}
          <div style="display:flex;gap:1rem;border-bottom:1px solid var(--color-border);padding-block:1rem;" data-qty-wrap data-cart-line-key="{{ item.key }}">
            <img src="{{ item.image | image_url: width: 200 }}" alt="" style="height:6rem;width:5rem;border-radius:4px;object-fit:cover;">
            <div style="flex:1;display:flex;flex-direction:column;">
              <div class="text-sm">{{ item.product.title }}</div>
              <div class="text-xs text-muted" style="margin-top:.25rem;">{{ item.variant.title }}</div>
              <div style="margin-top:auto;display:flex;align-items:center;justify-content:space-between;">
                <div class="qty-stepper">
                  <button type="button" data-qty-step="dec">−</button>
                  <span data-qty-value>{{ item.quantity }}</span>
                  <button type="button" data-qty-step="inc">+</button>
                </div>
                {% render 'line-price', item: item %}
              </div>
            </div>
            <button data-cart-remove="{{ item.key }}" aria-label="Remove" class="text-muted">{% render 'icon-trash' %}</button>
          </div>
        {% endfor %}
      </div>
      <div style="border-top:1px solid var(--color-border);padding:1.25rem 1.5rem;">
        {% render 'cart-totals' %}
        <form action="{{ routes.cart_url }}" method="post" novalidate>
          <button type="submit" name="checkout" class="btn btn-primary" style="width:100%;margin-top:1rem;">{{ 'general.cart.checkout' | t }}</button>
        </form>
        <a href="{{ routes.cart_url }}" class="btn btn-outline" style="display:block;text-align:center;margin-top:.75rem;width:100%;">{{ 'general.cart.view_cart' | t }}</a>
      </div>
    {% endif %}
  </aside>
</div>

{% schema %}
{ "name": "Cart drawer", "settings": [] }
{% endschema %}
