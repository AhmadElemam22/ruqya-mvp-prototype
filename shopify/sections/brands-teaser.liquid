<section class="container-r section">
  <div style="text-align:center;">
    <h2>{{ section.settings.heading | default: 'home.brands.heading' | t }}</h2>
    <p class="text-muted" style="margin-top:.75rem;">{{ section.settings.subheading | default: 'home.brands.subheading' | t }}</p>
  </div>
  <div class="grid-2" style="grid-template-columns:repeat(2,1fr);margin-top:3rem;">
    <style>@media(min-width:1024px){.brands-teaser-grid{grid-template-columns:repeat(6,1fr) !important;}}</style>
    {% for block in section.blocks %}
      <a href="{{ routes.collections_url }}/{{ block.settings.collection_handle }}" class="brand-tile">
        <div class="brand-tile__name">{{ block.settings.name }}</div>
        <div class="text-xs text-muted" style="margin-top:.25rem;">{{ collections[block.settings.collection_handle].products_count | default: block.settings.count }} {{ 'general.products' | t }}</div>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Brands teaser",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subheading", "label": "Subheading" }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "text", "id": "name", "label": "Brand name" },
        { "type": "text", "id": "collection_handle", "label": "Collection handle" },
        { "type": "number", "id": "count", "label": "Product count (display only)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brands teaser",
      "blocks": [
        { "type": "brand", "settings": { "name": "Levidor", "collection_handle": "levidor", "count": 8 } },
        { "type": "brand", "settings": { "name": "KARACA", "collection_handle": "karaca", "count": 18 } },
        { "type": "brand", "settings": { "name": "Keten", "collection_handle": "keten", "count": 18 } },
        { "type": "brand", "settings": { "name": "Aker", "collection_handle": "aker", "count": 3 } },
        { "type": "brand", "settings": { "name": "Valentino Orlandi", "collection_handle": "valentino-orlandi", "count": 8 } },
        { "type": "brand", "settings": { "name": "Pierre Cardin", "collection_handle": "pierre-cardin", "count": 1 } },
        { "type": "brand", "settings": { "name": "19V69 ITALIA", "collection_handle": "19v69-italia", "count": 2 } },
        { "type": "brand", "settings": { "name": "modakashmir", "collection_handle": "modakashmir", "count": 1 } }
      ]
    }
  ]
}
{% endschema %}
