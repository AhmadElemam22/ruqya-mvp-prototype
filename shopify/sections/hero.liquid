<section class="container-r hero-grid">
  <div class="fade-up">
    <div class="uppercase-tracked">{{ section.settings.eyebrow | default: 'home.hero.eyebrow' | t }}</div>
    <h1 class="hero-title">{{ section.settings.heading }}</h1>
    <p class="hero-copy">{{ section.settings.subheading | default: 'home.hero.subheading' | t }}</p>
    <div class="hero-actions">
      <a href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}" class="btn btn-primary">
        {{ section.settings.primary_label | default: 'home.hero.primary' | t }} {% render 'icon-arrow-right' %}
      </a>
      <a href="#materials" class="btn btn-outline">{{ section.settings.secondary_label | default: 'home.hero.secondary' | t }}</a>
    </div>
  </div>
  <div class="hero-media">
    {% if section.settings.image %}
      <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="">
    {% else %}
      {% assign hero_product = collections.all.products.first %}
      {% if hero_product.featured_image %}<img src="{{ hero_product.featured_image | image_url: width: 1000 }}" alt="">{% endif %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "RUQYA" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "primary_label", "label": "Primary button label" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
