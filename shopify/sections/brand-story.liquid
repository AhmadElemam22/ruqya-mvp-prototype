<section style="background:var(--color-surface);" class="section">
  <div class="container-r" style="display:grid;gap:3rem;align-items:center;">
    <style>@media(min-width:768px){.brand-story-grid{grid-template-columns:1fr 1fr;gap:4rem;}}</style>
    <div class="brand-story-grid" style="display:grid;gap:3rem;align-items:center;">
      <div class="hero-media" style="aspect-ratio:4/5;">
        {% if section.settings.image %}<img src="{{ section.settings.image | image_url: width: 900 }}" alt="">{% else %}{% assign story_product = collections.all.products[1] | default: collections.all.products.first %}{% if story_product.featured_image %}<img src="{{ story_product.featured_image | image_url: width: 900 }}" alt="">{% endif %}{% endif %}
      </div>
      <div>
        <div class="uppercase-tracked">{{ section.settings.eyebrow | default: 'home.story.eyebrow' | t }}</div>
        <h2 style="margin-top:.75rem;">{{ section.settings.heading | default: 'home.story.heading' | t }}</h2>
        <p class="text-muted" style="margin-top:1rem;">{{ section.settings.subheading | default: 'home.story.subheading' | t }}</p>
        <div style="margin-top:2rem;display:grid;gap:1.5rem;grid-template-columns:1fr;">
          <style>@media(min-width:640px){.feature-grid{grid-template-columns:1fr 1fr;}}</style>
          <div class="feature-grid" style="display:grid;gap:1.5rem;grid-template-columns:1fr 1fr;">
            {% for block in section.blocks %}
              <div style="display:flex;gap:.75rem;">
                <div style="flex-shrink:0;color:var(--color-primary);">{{ block.settings.icon }}</div>
                <div>
                  {% capture ft %}home.story.{{ block.id }}.title{% endcapture %}<div class="text-sm" style="font-weight:500;">{{ block.settings.title | default: ft | t }}</div>
                  {% capture fd %}home.story.{{ block.id }}.description{% endcapture %}<div class="text-sm text-muted">{{ block.settings.description | default: fd | t }}</div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>

        {% if section.settings.arabic_html != blank %}
          <div class="rtl-callout">
            {{ section.settings.arabic_html }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "richtext", "id": "arabic_html", "label": "Arabic callout (RTL box)" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon glyph (emoji or text)", "default": "✦" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "description", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand story",
      "blocks": [
        { "type": "feature", "settings": { "title": "Advanced Soft-Touch Fiber", "description": "Gentle on the skin with lasting comfort" } },
        { "type": "feature", "settings": { "title": "Original Turkish Brand", "description": "Authentic quality you can trust" } },
        { "type": "feature", "settings": { "title": "Woven, never printed", "description": "Designs woven into the fabric" } },
        { "type": "feature", "settings": { "title": "Natural breathability", "description": "Lasting stability and softness" } }
      ]
    }
  ]
}
{% endschema %}
