<section class="container-r section" id="materials">
  <div class="section-head">
    <div class="uppercase-tracked">{{ section.settings.eyebrow | default: 'home.materials.eyebrow' | t }}</div>
    <h2>{{ section.settings.heading | default: 'home.materials.heading' | t }}</h2>
    <p class="text-muted" style="margin-top:.75rem;">{{ section.settings.subheading | default: 'home.materials.subheading' | t }}</p>
  </div>
  <div class="grid-2" style="margin-top:3rem;">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% render 'material-tile', col: block.settings.collection, label: block.settings.label, image: block.settings.image %}
      {% endfor %}
    {% else %}
      {% for col in collections %}
        {% if col.metafields.custom.is_material %}
          {% render 'material-tile', col: col %}
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Materials grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" }
  ],
  "blocks": [
    {
      "type": "material",
      "name": "Material",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label override" },
        { "type": "image_picker", "id": "image", "label": "Image (fallback if collection has none)" }
      ]
    }
  ],
  "presets": [{ "name": "Materials grid" }]
}
{% endschema %}
