<section class="container-r" style="padding-top:2rem;">
  <nav class="breadcrumbs"><a href="{{ routes.root_url }}">{{ 'general.nav.home' | t }}</a><span style="margin-inline:.5rem;">/</span><span style="color:var(--color-foreground);">{{ 'general.nav.brands' | t }}</span></nav>
</section>
<section class="container-r" style="padding-block:3rem;">
  <h1 style="font-size:3rem;">{{ section.settings.heading | default: 'brands.page.heading' | t }}</h1>
  <p class="text-muted" style="margin-top:1rem;max-width:42rem;">{{ section.settings.subheading | default: 'brands.page.subheading' | t }}</p>
</section>
<section class="container-r" style="padding-bottom:6rem;">
  <style>@media(min-width:1024px){.brands-page-grid{grid-template-columns:repeat(3,1fr) !important;}}</style>
  <div class="brands-page-grid" style="display:grid;gap:1.5rem;grid-template-columns:1fr 1fr;">
    {% comment %} Every vendor in the store gets a card automatically. A "Brand" block with the same name only adds a description / image. {% endcomment %}
    {% for vendor in shop.vendors %}
      {% capture vh %}{% render 'vendor-handle', vendor: vendor %}{% endcapture %}
      {% assign vh = vh | strip %}
      {% assign brand_block = nil %}
      {% for block in section.blocks %}
        {% assign block_handle = block.settings.name | handleize %}
        {% if block_handle == vh %}{% assign brand_block = block %}{% endif %}
      {% endfor %}
      {% if brand_block and brand_block.settings.collection_handle != blank %}
        {% assign col = collections[brand_block.settings.collection_handle] %}
      {% else %}
        {% assign col = collections[vh] %}
      {% endif %}

      {% assign brand_image = brand_block.settings.image | default: col.image %}
      {% assign brand_count = col.products_count %}
      {% if brand_image == blank or col.id == blank %}
        {% assign vendor_products = collections.all.products | where: 'vendor', vendor %}
        {% if brand_image == blank %}{% assign brand_image = vendor_products.first.featured_image | default: col.products.first.featured_image %}{% endif %}
        {% if col.id == blank %}{% assign brand_count = vendor_products.size %}{% endif %}
      {% endif %}

      <a href="{% if col.id %}{{ col.url }}{% else %}{{ vendor | url_for_vendor }}{% endif %}" class="brand-banner">
        {% if brand_image %}
          <img src="{{ brand_image | image_url: width: 700 }}" alt="{{ vendor | escape }}" loading="lazy">
        {% endif %}
        <div class="brand-banner__text">
          <div style="font-size:1.875rem;font-family:var(--font-serif);">{{ vendor }}</div>
          <div class="brand-banner__meta">
            <span style="opacity:.8;">{{ brand_count }} {{ 'general.products' | t }}</span>
            <span>{{ 'general.shop' | t }} {{ vendor }} →</span>
          </div>
        </div>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Brands page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "text", "id": "name", "label": "Vendor name", "info": "Must match the product Vendor exactly (e.g. KARACA). Brands appear automatically; this block only adds details." },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "image_picker", "id": "image", "label": "Image (optional)" },
        { "type": "text", "id": "collection_handle", "label": "Collection handle (optional)", "info": "Defaults to the vendor name as a handle, e.g. valentino-orlandi" },
        { "type": "number", "id": "count", "label": "Fallback product count (unused)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brands page",
      "blocks": [
        { "type": "brand", "settings": { "name": "Levidor", "description": "Artistic Indian silk patterns with modern geometric and floral designs", "collection_handle": "levidor", "count": 8 } },
        { "type": "brand", "settings": { "name": "KARACA", "description": "Premium Turkish chiffon, cotton, voile, and satin hijabs", "collection_handle": "karaca", "count": 18 } },
        { "type": "brand", "settings": { "name": "Keten", "description": "Linen-blend hijabs with contemporary artistic weaves", "collection_handle": "keten", "count": 18 } },
        { "type": "brand", "settings": { "name": "Aker", "description": "Luxury viscose and satin jacquard fabrics", "collection_handle": "aker", "count": 3 } },
        { "type": "brand", "settings": { "name": "Valentino Orlandi", "description": "High-end lyocell jacquard hijabs", "collection_handle": "valentino-orlandi", "count": 8 } },
        { "type": "brand", "settings": { "name": "Pierre Cardin", "description": "Premium cotton hijabs with classic elegance", "collection_handle": "pierre-cardin", "count": 1 } }
      ]
    }
  ]
}
{% endschema %}
