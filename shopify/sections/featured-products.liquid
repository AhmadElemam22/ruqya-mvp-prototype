<section class="container-r section">
  <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;flex-wrap:wrap;">
    <div>
      <h2>{{ section.settings.heading | default: 'home.featured.heading' | t }}</h2>
      <p class="text-muted" style="margin-top:.75rem;">{{ section.settings.subheading | default: 'home.featured.subheading' | t }}</p>
    </div>
    {% if section.settings.collection %}
      <a href="{{ section.settings.collection.url }}" class="text-sm" style="text-decoration:underline;">{{ 'general.view_all' | t }}</a>
    {% endif %}
  </div>
  <div class="product-grid">
    {% assign col = section.settings.collection | default: collections.all %}
    {% for product in col.products limit: section.settings.count %}
      {% render 'product-card', product: product %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "collection", "id": "collection", "label": "Collection (blank = all products)" },
    { "type": "range", "id": "count", "label": "Number of products", "min": 4, "max": 16, "step": 4, "default": 8 }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
