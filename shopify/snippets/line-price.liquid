{%- comment -%}
  shortcut: spreads the cart-level discount by line value, exact for the store's flat % order discounts; switch to item.discount_allocations if per-product discounts are added.
{%- endcomment -%}
{%- if cart.items_subtotal_price > cart.total_price and cart.items_subtotal_price > 0 -%}
  {%- assign discounted = item.final_line_price | times: cart.total_price | divided_by: cart.items_subtotal_price -%}
  {%- assign pct = cart.items_subtotal_price | minus: cart.total_price | times: 100 | divided_by: cart.items_subtotal_price -%}
  <div class="line-price">
    <div class="line-price__old"><s>{{ item.final_line_price | money }}</s><em class="tier-badge">-{{ pct }}%</em></div>
    <span class="line-price__new">{{ discounted | money }}</span>
  </div>
{%- else -%}
  <div class="text-sm" style="white-space:nowrap;">{{ item.final_line_price | money }}</div>
{%- endif -%}
