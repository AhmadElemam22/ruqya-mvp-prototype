{% comment %}
  Usage: {% render 'color-hex', name: variant.title, product: product %} outputs a CSS color.
  Prefers the swatch color set in Shopify admin (category Color metafield), then falls back to the map below.
{% endcomment %}
{%- assign swatch_color = blank -%}
{%- if product -%}
  {%- for option in product.options_with_values -%}
    {%- for value in option.values -%}
      {%- if value.name == name and value.swatch.color != blank -%}
        {%- assign candidate = value.swatch.color | append: '' | strip -%}
        {%- if candidate contains '#' or candidate contains 'rgb' -%}
          {%- assign swatch_color = candidate -%}
          {%- break -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if swatch_color != blank -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- if swatch_color != blank -%}{{ swatch_color }}
{%- else -%}
{%- assign key = name | downcase | replace: '-', ' ' | strip -%}
{%- case key -%}
  {%- when 'rose dust' -%}#C8A0A0
  {%- when 'sage' -%}#8FA68E
  {%- when 'ivory' -%}#F2EAD3
  {%- when 'navy' -%}#2A3A55
  {%- when 'midnight navy' -%}#1C2541
  {%- when 'blush' -%}#E8C8C0
  {%- when 'gold' -%}#C4A882
  {%- when 'champagne gold' -%}#D8C39A
  {%- when 'golden amber' -%}#D49A3A
  {%- when 'light amber' -%}#E2B36B
  {%- when 'charcoal' -%}#3A3A3A
  {%- when 'terracotta' -%}#C4704B
  {%- when 'mist' -%}#BFC8C8
  {%- when 'plum' -%}#5A3A4A
  {%- when 'black' -%}#1A1A1A
  {%- when 'white' -%}#FFFFFF
  {%- when 'brown' -%}#7B4A2E
  {%- when 'warm mocha', 'mocha' -%}#8C6A54
  {%- when 'smoky mauve' -%}#8E7080
  {%- when 'mauve' -%}#A87F94
  {%- when 'beige' -%}#E6D3B3
  {%- when 'sand' -%}#D8C3A0
  {%- when 'iced latte' -%}#C9AE8E
  {%- when 'gray', 'grey' -%}#8A8A8A
  {%- when 'light grey', 'light gray' -%}#C4C4C4
  {%- when 'dark grey', 'dark gray' -%}#555555
  {%- when 'coffee grey' -%}#6E625A
  {%- when 'cream', 'soft cream' -%}#F3E9D2
  {%- when 'pale nude cream' -%}#EBDCCB
  {%- when 'light peach cream' -%}#F4DCC8
  {%- when 'peach' -%}#F2A27C
  {%- when 'camel' -%}#C19A6B
  {%- when 'khaki' -%}#BDB07F
  {%- when 'olive', 'olive green' -%}#6B6B3A
  {%- when 'green' -%}#4F7A52
  {%- when 'dark green' -%}#2F4B33
  {%- when 'light sage green' -%}#B5C4A8
  {%- when 'blue' -%}#3A5A8C
  {%- when 'baby blue' -%}#A9CBE8
  {%- when 'light blue' -%}#8EC1DE
  {%- when 'ice blue' -%}#CFE3EC
  {%- when 'ocean blue' -%}#2F6E95
  {%- when 'bright azure' -%}#2E8FE0
  {%- when 'petrol blue' -%}#1F5866
  {%- when 'light petrol' -%}#4F8A92
  {%- when 'soft light aqua' -%}#BFE6E3
  {%- when 'red' -%}#A83232
  {%- when 'crimson red' -%}#B0172C
  {%- when 'burgundy', 'maroon' -%}#6D1F2B
  {%- when 'pink' -%}#E3A6B4
  {%- when 'powder pink' -%}#F1C9CF
  {%- when 'dusty rose', 'muted rose' -%}#C9939A
  {%- when 'purple' -%}#6A4C7A
  {%- when 'dusty purple' -%}#8C7290
  {%- when 'medium violet' -%}#8A5BB0
  {%- when 'lilac', 'lavender' -%}#C8B6D9
  {%- when 'muted lavender' -%}#B4A7C2
  {%- when 'soft pastel lilac' -%}#D9CBE6
  {%- when 'orange' -%}#D9822B
  {%- when 'bright orange' -%}#F07A1A
  {%- when 'light orange' -%}#F3B07A
  {%- when 'yellow', 'mustard' -%}#D4A93A
  {%- when 'deep mustard' -%}#B88A1B
  {%- when 'mint' -%}#A8D5BA
  {%- when 'turquoise', 'teal' -%}#3A8C8C
  {%- when 'bright turquoise' -%}#1FB5B0
  {%- comment -%} Two-tone and multi-color names get a split swatch {%- endcomment -%}
  {%- when 'black and burgundy chain' -%}linear-gradient(135deg,#1A1A1A 50%,#6D1F2B 50%)
  {%- when 'camel brown and sage' -%}linear-gradient(135deg,#B08458 50%,#8FA68E 50%)
  {%- when 'petrol and coral' -%}linear-gradient(135deg,#1F5866 50%,#F08A6E 50%)
  {%- when 'purple and caffee', 'purple and coffee' -%}linear-gradient(135deg,#6A4C7A 50%,#6F4E37 50%)
  {%- when 'pink and blue watercolor' -%}linear-gradient(135deg,#E3A6B4 50%,#8EC1DE 50%)
  {%- when 'blue multi' -%}linear-gradient(135deg,#3A5A8C,#8EC1DE,#F3E9D2)
  {%- when 'green multi' -%}linear-gradient(135deg,#4F7A52,#B5C4A8,#F3E9D2)
  {%- when 'plum multi' -%}linear-gradient(135deg,#5A3A4A,#C8B6D9,#F3E9D2)
  {%- when 'turquoise multi' -%}linear-gradient(135deg,#1FB5B0,#BFE6E3,#F3E9D2)
  {%- when 'yellow multi' -%}linear-gradient(135deg,#D4A93A,#F3D98B,#F3E9D2)
  {%- else -%}
    {%- comment -%} Unknown name: guess from a color word inside it (e.g. "Sky Blue" → blue) {%- endcomment -%}
    {%- if key contains 'grey' or key contains 'gray' -%}#8A8A8A
    {%- elsif key contains 'navy' -%}#2A3A55
    {%- elsif key contains 'turquoise' or key contains 'aqua' or key contains 'teal' -%}#3A8C8C
    {%- elsif key contains 'blue' or key contains 'azure' or key contains 'petrol' -%}#3A5A8C
    {%- elsif key contains 'green' or key contains 'sage' or key contains 'olive' or key contains 'mint' -%}#4F7A52
    {%- elsif key contains 'burgundy' or key contains 'maroon' or key contains 'wine' -%}#6D1F2B
    {%- elsif key contains 'red' or key contains 'crimson' -%}#A83232
    {%- elsif key contains 'pink' or key contains 'rose' or key contains 'blush' -%}#E3A6B4
    {%- elsif key contains 'lilac' or key contains 'lavender' -%}#C8B6D9
    {%- elsif key contains 'purple' or key contains 'violet' or key contains 'plum' -%}#6A4C7A
    {%- elsif key contains 'orange' or key contains 'peach' or key contains 'coral' -%}#F08A50
    {%- elsif key contains 'yellow' or key contains 'mustard' or key contains 'amber' -%}#D4A93A
    {%- elsif key contains 'gold' -%}#C4A882
    {%- elsif key contains 'brown' or key contains 'coffee' or key contains 'camel' or key contains 'latte' -%}#7B4A2E
    {%- elsif key contains 'cream' or key contains 'nude' or key contains 'beige' or key contains 'sand' or key contains 'ivory' -%}#F3E9D2
    {%- elsif key contains 'black' -%}#1A1A1A
    {%- elsif key contains 'white' -%}#FFFFFF
    {%- else -%}#CCCCCC
    {%- endif -%}
{%- endcase -%}
{%- endif -%}
